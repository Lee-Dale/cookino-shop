# PostgreSQL ------------------------------------------------
# Im Docker-Netzwerk heißt der Host exakt wie der Service in compose.yaml.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cookino_shop
POSTGRES_USER=cookino
POSTGRES_PASSWORD=cookino_dev_passwort

# MongoDB ---------------------------------------------------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=cookino_shop
MONGO_USER=cookino_admin
MONGO_PASSWORD=cookino_mongo_dev_passwort
MONGO_AUTH_SOURCE=admin

# Die drei Namen entsprechen exakt init-mongo.js und shop_main.py.
MONGO_PRODUCT_COLLECTION=produkt_inhalte
MONGO_COLLECTION_COLLECTION=kollektion_inhalte
MONGO_MEDIA_COLLECTION=medien

# Bilder bleiben in S3. Ist keine Basis-URL gesetzt, liefert Python den S3-Key.
# Beispiel: https://cdn.eure-domain.de
CLOUDFRONT_URL=

# Login-Schutz aus konto_shop.py
MAX_LOGIN_VERSUCHE=3
LOGIN_SPERRE_SEKUNDEN=60
